<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1><%= t('servicesPage.pageTitle') %></h1>
      <p style="margin-bottom:0;"><%= t('servicesPage.pageSubtitle') %></p>
    </div>
  </section>

  <!-- Services List -->
  <section class="section">
    <div class="container">
      <div style="display:flex; flex-direction:column; gap:32px;">
        <% services.forEach((srv, idx) => { %>
          <div class="card">
            <div class="grid-2" style="gap:24px; align-items:center;">
              <div class="card-img" style="height:240px; margin:0; border-radius:4px;">
                <img src="<%= srv.heroImage %>" alt="<%= srv.title %>">
              </div>
              <div>
                <h2 style="font-size:1.5rem; color:var(--primary-navy); margin-bottom:8px;">
                  <%= (idx + 1) + '. ' + srv.title %>
                </h2>
                <p style="color:var(--slate-text); margin-bottom:14px;">
                  <%= srv.shortDescription %>
                </p>
                <ul class="card-list">
                  <% srv.keyFeatures.slice(0, 4).forEach(feat => { %>
                    <li><strong><%= feat.title %>:</strong> <%= feat.description %></li>
                  <% }); %>
                </ul>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;">
                  <a href="/quote" class="btn btn-primary btn-sm"><%= t('common.requestQuote') %></a>
                  <a href="/services/<%= srv.slug %>" class="btn btn-outline btn-sm"><%= t('common.learnMore') %></a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- CTA Bar -->
  <section class="cta-bar">
    <div class="container">
      <h2><%= t('servicesPage.ctaTitle') %></h2>
      <p><%= t('servicesPage.ctaDesc') %></p>
      <a href="/quote" class="btn btn-accent"><%= t('common.requestQuote') %></a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
