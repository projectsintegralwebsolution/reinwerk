<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1><%= t('about.pageTitle') %></h1>
      <p style="margin-bottom:0;"><%= t('about.pageSubtitle') %></p>
    </div>
  </section>

  <!-- About Details -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:40px; margin-bottom:40px;">
        <div>
          <h2><%= t('about.leadTitle') %></h2>
          <p style="margin-bottom:16px; color:var(--slate-text);">
            <%= t('about.leadP1') %>
          </p>
          <p style="margin-bottom:16px; color:var(--slate-text);">
            <%= t('about.leadP2') %>
          </p>
        </div>

        <div class="card">
          <h3 class="card-title"><%= t('about.overviewTitle') %></h3>
          <p class="card-desc"><strong><%= t('about.companyLabel') %></strong> <%= t('about.companyVal') %></p>
          <p class="card-desc"><strong><%= t('about.expertiseLabel') %></strong> <%= t('about.expertiseVal') %></p>
          <p class="card-desc"><strong><%= t('about.scopeLabel') %></strong> <%= t('about.scopeVal') %></p>
          <p class="card-desc" style="margin-bottom:0;"><strong><%= t('about.standardsLabel') %></strong> <%= t('about.standardsVal') %></p>
        </div>
      </div>

      <!-- Standards & Quality -->
      <div class="card" style="margin-bottom:40px;">
        <h3 class="card-title"><%= t('about.qualityTitle') %></h3>
        <p class="card-desc"><%= t('about.qualityIntro') %></p>
        <div class="grid-3" style="margin-top:16px;">
          <div>
            <h4 style="font-size:1rem; color:var(--primary-navy);"><%= t('about.isoTitle') %></h4>
            <p style="font-size:0.875rem; color:var(--slate-text);"><%= t('about.isoDesc') %></p>
          </div>
          <div>
            <h4 style="font-size:1rem; color:var(--primary-navy);"><%= t('about.gmpTitle') %></h4>
            <p style="font-size:0.875rem; color:var(--slate-text);"><%= t('about.gmpDesc') %></p>
          </div>
          <div>
            <h4 style="font-size:1rem; color:var(--primary-navy);"><%= t('about.gampTitle') %></h4>
            <p style="font-size:0.875rem; color:var(--slate-text);"><%= t('about.gampDesc') %></p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="/contact" class="btn btn-primary"><%= t('common.contactUs') %></a>
        <a href="/services" class="btn btn-outline" style="margin-left:12px;"><%= t('common.ourServices') %></a>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
