<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1>About REINWERK</h1>
      <p style="margin-bottom:0;">Specialist cleanroom and plant engineering services based on German engineering standards.</p>
    </div>
  </section>

  <!-- About Details -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:40px; margin-bottom:40px;">
        <div>
          <h2>Company Profile</h2>
          <p style="margin-bottom:16px; color:var(--slate-text);">
            REINWERK Reinraum- und Anlagentechnik is dedicated to providing high-reliability cleanroom systems for manufacturing, research, and healthcare facilities. We work closely with our clients from initial concept and space planning through manufacturing, commissioning, and validation.
          </p>
          <p style="margin-bottom:16px; color:var(--slate-text);">
            Whether you require a small modular clean booth or an extensive multi-room pharmaceutical suite, our team delivers solutions that meet your exact contamination control criteria and regulatory expectations.
          </p>
        </div>

        <div class="card">
          <h3 class="card-title">Corporate Overview</h3>
          <p class="card-desc"><strong>Company:</strong> REINWERK Reinraum- und Anlagentechnik GmbH</p>
          <p class="card-desc"><strong>Expertise:</strong> German Cleanroom & Plant Engineering</p>
          <p class="card-desc"><strong>Scope:</strong> Turnkey Cleanrooms, HVAC Systems, Pass-Through Airlocks, Validation Services</p>
          <p class="card-desc" style="margin-bottom:0;"><strong>Standards:</strong> DIN EN ISO 14644, EU-GMP Annex 1, VDI 2083</p>
        </div>
      </div>

      <!-- Standards & Quality -->
      <div class="card" style="margin-bottom:40px;">
        <h3 class="card-title">Our Quality Standards</h3>
        <p class="card-desc">All our cleanroom installations and documentation follow recognized international guidelines:</p>
        <div class="grid-3" style="margin-top:16px;">
          <div>
            <h4 style="font-size:1rem; color:var(--primary-navy);">ISO 14644-1:2015</h4>
            <p style="font-size:0.875rem; color:var(--slate-text);">Classification of air cleanliness by particle concentration from ISO Class 3 to ISO Class 9.</p>
          </div>
          <div>
            <h4 style="font-size:1rem; color:var(--primary-navy);">EU-GMP Annex 1</h4>
            <p style="font-size:0.875rem; color:var(--slate-text);">Manufacture of sterile medicinal products across Grades A, B, C, and D.</p>
          </div>
          <div>
            <h4 style="font-size:1rem; color:var(--primary-navy);">GAMP 5 Validation</h4>
            <p style="font-size:0.875rem; color:var(--slate-text);">Structured Design, Installation, Operational, and Performance Qualification (DQ/IQ/OQ/PQ).</p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="/contact" class="btn btn-primary">Contact Our Engineering Team</a>
        <a href="/services" class="btn btn-outline" style="margin-left:12px;">View Our Services</a>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
