<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1><%= t('projectsPage.pageTitle') %></h1>
      <p style="margin-bottom:0;"><%= t('projectsPage.pageSubtitle') %></p>
    </div>
  </section>

  <!-- Projects List -->
  <section class="section">
    <div class="container">
      <div style="display:flex; flex-direction:column; gap:32px;">
        <% projects.forEach(p => { %>
          <div class="card">
            <div class="grid-2" style="gap:24px; align-items:center;">
              <div class="card-img" style="height:220px; margin:0; border-radius:4px;">
                <img src="<%= p.thumbnail %>" alt="<%= p.title %>">
              </div>
              <div>
                <span style="font-size:0.8125rem; font-weight:700; color:var(--accent-red); text-transform:uppercase;">
                  <%= p.clientSector %> • <%= p.location %> (<%= p.completionYear %>)
                </span>
                <h2 style="font-size:1.35rem; color:var(--primary-navy); margin:6px 0 10px;"><%= p.title %></h2>
                <p style="font-size:0.9375rem; color:var(--slate-text); margin-bottom:12px;"><%= p.summary %></p>
                <div style="background:var(--slate-light); padding:10px 14px; border-radius:4px; font-size:0.875rem; margin-bottom:16px;">
                  <strong><%= lang === 'en' ? 'Specifications:' : 'Kenndaten:' %></strong> <%= p.area %> <%= lang === 'en' ? 'Floor Area' : 'Nutzfläche' %> | <%= p.isoClass %> | <%= p.gmpGrade %>
                </div>
                <a href="/quote" class="btn btn-outline btn-sm"><%= t('projectsPage.requestSimilar') %></a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- CTA Bar -->
  <section class="cta-bar">
    <div class="container">
      <h2><%= t('projectsPage.ctaTitle') %></h2>
      <p><%= t('projectsPage.ctaDesc') %></p>
      <a href="/contact" class="btn btn-accent"><%= t('common.contactUs') %></a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
