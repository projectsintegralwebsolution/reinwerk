<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- 404 Section -->
  <section class="section" style="padding:120px 0; text-align:center;">
    <div class="container">
      <div style="max-width:600px; margin:0 auto;">
        <span class="eyebrow" style="color:var(--accent-red);"><%= t('notFound.eyebrow') %></span>
        <h1 style="font-size:3.5rem; color:var(--primary-navy); margin-bottom:16px;"><%= t('notFound.title') %></h1>
        <p style="font-size:1.125rem; color:var(--slate-600); margin-bottom:32px;">
          <%= t('notFound.desc') %>
        </p>
        <div style="display:flex; justify-content:center; gap:16px;">
          <a href="/" class="btn btn-primary"><%= t('notFound.backHome') %></a>
          <a href="/services" class="btn btn-outline"><%= t('notFound.exploreServices') %></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <%- include('../partials/footer') %>
</body>
</html>
