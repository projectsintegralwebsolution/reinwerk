<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1><%= t('industriesPage.pageTitle') %></h1>
      <p style="margin-bottom:0;"><%= t('industriesPage.pageSubtitle') %></p>
    </div>
  </section>

  <!-- Industries Grid -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:30px;">
        <% industries.forEach(ind => { %>
          <div class="card">
            <div class="card-img" style="height:200px;">
              <img src="<%= ind.heroImage %>" alt="<%= ind.title %>">
            </div>
            <h2 class="card-title"><%= ind.title %></h2>
            <p class="card-desc">
              <strong><%= lang === 'en' ? 'Typical Standard:' : 'Typischer Reinraumstandard:' %></strong> 
              <%= ind.isoClass %> <% if (ind.gmpGrade && ind.gmpGrade !== 'N/A') { %> / <%= ind.gmpGrade %><% } %>
            </p>
            <p class="card-desc">
              <%= ind.shortDescription %>
            </p>
            <ul class="card-list">
              <% ind.reinwerkSolutions.slice(0, 3).forEach(sol => { %>
                <li><%= sol %></li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- CTA Bar -->
  <section class="cta-bar">
    <div class="container">
      <h2><%= t('industriesPage.ctaTitle') %></h2>
      <p><%= t('industriesPage.ctaDesc') %></p>
      <a href="/quote" class="btn btn-accent"><%= t('common.requestQuote') %></a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
