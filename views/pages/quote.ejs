<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1><%= t('quotePage.pageTitle') %></h1>
      <p style="margin-bottom:0;"><%= t('quotePage.pageSubtitle') %></p>
    </div>
  </section>

  <!-- Quote Form Section -->
  <section class="section">
    <div class="container">
      <div class="form-box">
        <h2 style="font-size:1.5rem; color:var(--primary-navy); margin-bottom:8px;"><%= t('quotePage.formTitle') %></h2>
        <p style="font-size:0.9375rem; color:var(--slate-text); margin-bottom:28px;">
          <%= t('quotePage.formSubtitle') %>
        </p>

        <form id="simpleQuoteForm">
          <input type="hidden" name="lang" value="<%= lang %>">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="fullName"><%= t('quotePage.nameLabel') %></label>
              <input type="text" id="fullName" name="fullName" class="form-input" placeholder="<%= t('quotePage.namePlaceholder') %>" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="company"><%= t('quotePage.companyLabel') %></label>
              <input type="text" id="company" name="company" class="form-input" placeholder="<%= t('quotePage.companyPlaceholder') %>" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="email"><%= t('quotePage.emailLabel') %></label>
              <input type="email" id="email" name="email" class="form-input" placeholder="<%= t('quotePage.emailPlaceholder') %>" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="phone"><%= t('quotePage.phoneLabel') %></label>
              <input type="tel" id="phone" name="phone" class="form-input" placeholder="<%= t('quotePage.phonePlaceholder') %>" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="industry"><%= t('quotePage.industryLabel') %></label>
              <select id="industry" name="industry" class="form-select" required>
                <option value="Pharmaceutical / Biotech"><%= t('contactPage.sectorPharma') %></option>
                <option value="Semiconductor / Electronics"><%= t('contactPage.sectorSemi') %></option>
                <option value="Medical Devices"><%= t('contactPage.sectorMedtech') %></option>
                <option value="Aerospace / Optics"><%= t('contactPage.sectorAero') %></option>
                <option value="Healthcare / Hospital"><%= lang === 'en' ? 'Healthcare & Compounding' : 'Krankenhaus- & Zytostatikazubereitung' %></option>
                <option value="Other"><%= t('contactPage.sectorOther') %></option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="targetStandard"><%= t('quotePage.standardLabel') %></label>
              <select id="targetStandard" name="targetStandard" class="form-select" required>
                <option value="ISO 4 (GMP Grade A Equivalent)">ISO Class 4 (GMP Grade A / Klasse 10)</option>
                <option value="ISO 5 (GMP Grade B/A localized)">ISO Class 5 (GMP Grade B / A Localized)</option>
                <option value="ISO 6 (GMP Grade B/C)">ISO Class 6 (GMP Grade B/C)</option>
                <option value="ISO 7 (GMP Grade C / Class 10,000)" selected>ISO Class 7 (GMP Grade C / Class 10.000)</option>
                <option value="ISO 8 (GMP Grade D / Class 100,000)">ISO Class 8 (GMP Grade D / Class 100.000)</option>
                <option value="Not Sure / Need Advice"><%= lang === 'en' ? 'Not Sure / Need Engineering Advice' : 'Noch unklar / Technische Beratung gewünscht' %></option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="approxArea"><%= t('quotePage.areaLabel') %></label>
              <input type="text" id="approxArea" name="approxArea" class="form-input" placeholder="<%= t('quotePage.areaPlaceholder') %>">
            </div>
            <div class="form-group">
              <label class="form-label" for="timeline"><%= t('quotePage.timelineLabel') %></label>
              <select id="timeline" name="timeline" class="form-select">
                <option value="Immediate (< 3 Months)"><%= t('quotePage.timelineImmediate') %></option>
                <option value="3 - 6 Months" selected><%= t('quotePage.timelineMedium') %></option>
                <option value="6 - 12 Months"><%= t('quotePage.timelineLong') %></option>
                <option value="Future Planning"><%= t('quotePage.timelineFuture') %></option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="additionalNotes"><%= t('quotePage.notesLabel') %></label>
            <textarea id="additionalNotes" name="additionalNotes" class="form-textarea" placeholder="<%= t('quotePage.notesPlaceholder') %>"></textarea>
          </div>

          <button type="submit" class="btn btn-accent btn-lg" style="width:100%;"><%= t('quotePage.submitBtn') %></button>
        </form>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const quoteForm = document.getElementById("simpleQuoteForm");
      if (!quoteForm) return;

      quoteForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = quoteForm.querySelector("button[type=submit]");
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "<%= t('common.submitting') %>";

        try {
          const formData = new FormData(quoteForm);
          const data = Object.fromEntries(formData.entries());

          const areaNum = parseFloat(data.approxArea) || 50;
          data.roomLength = Math.round(Math.sqrt(areaNum * 1.5));
          data.roomWidth = Math.round(areaNum / data.roomLength);
          data.roomHeight = 3.0;

          const response = await fetch("/api/quote", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
          });

          const result = await response.json();
          if (response.ok && result.success) {
            window.showToast(result.message, "success");
            quoteForm.reset();
          } else {
            window.showToast(result.message || "<%= lang === 'en' ? 'Failed to submit quote.' : 'Fehler beim Übermitteln der Anfrage.' %>", "error");
          }
        } catch (err) {
          window.showToast("<%= lang === 'en' ? 'An error occurred while submitting.' : 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.' %>", "error");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    });
  </script>
</body>
</html>
