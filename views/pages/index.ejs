<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Cleanroom & Plant Engineering Solutions</h1>
        <p>
          REINWERK Reinraum- und Anlagentechnik delivers turnkey modular cleanrooms, precision HVAC air filtration, and regulatory validation compliant with ISO 14644 and EU-GMP standards.
        </p>
        <div class="hero-buttons">
          <a href="/quote" class="btn btn-accent">Request a Quote</a>
          <a href="/services" class="btn btn-outline" style="border-color:var(--white); color:var(--white);">Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>Our Core Services</h2>
        <p>Reliable cleanroom engineering solutions tailored to your operational requirements.</p>
      </div>

      <div class="grid-4">
        <div class="card">
          <div class="card-img">
            <img src="/images/cleanrooms/modular-suite.jpg" alt="Modular Cleanroom Systems">
          </div>
          <h3 class="card-title">Modular Cleanrooms</h3>
          <p class="card-desc">Hardwall and cassette partition envelopes engineered for quick installation and clean operations.</p>
          <ul class="card-list">
            <li>ISO Class 3 to ISO Class 9</li>
            <li>Flush wall and ceiling finishes</li>
            <li>Demountable and reconfigurable</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-img">
            <img src="/images/cleanrooms/hvac-filtration.jpg" alt="HVAC & Air Filtration">
          </div>
          <h3 class="card-title">HVAC & Air Filtration</h3>
          <p class="card-desc">Custom air handling units with multi-stage HEPA/ULPA filtration and stable pressure cascades.</p>
          <ul class="card-list">
            <li>H14 HEPA & U15 ULPA filters</li>
            <li>Differential pressure regulation</li>
            <li>Precise temperature & humidity</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-img">
            <img src="/images/cleanrooms/equipment-passbox.jpg" alt="Cleanroom Equipment">
          </div>
          <h3 class="card-title">Cleanroom Equipment</h3>
          <p class="card-desc">Personnel air showers, dynamic pass-through airlocks, and stainless steel transfer equipment.</p>
          <ul class="card-list">
            <li>304 & 316L stainless steel</li>
            <li>Interlocked magnetic door systems</li>
            <li>Integrated HEPA purge airflows</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-img">
            <img src="/images/cleanrooms/validation-testing.jpg" alt="Validation & Testing">
          </div>
          <h3 class="card-title">Validation & Testing</h3>
          <p class="card-desc">Comprehensive commissioning, airborne particle count verification, and filter integrity testing.</p>
          <ul class="card-list">
            <li>DQ, IQ, OQ, PQ documentation</li>
            <li>ISO 14644-1:2015 certification</li>
            <li>Routine maintenance agreements</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- About Company Intro -->
  <section class="section section-alt">
    <div class="container">
      <div class="grid-2" style="align-items: center;">
        <div>
          <h2>About REINWERK</h2>
          <p style="margin-bottom: 16px; color:var(--slate-text);">
            REINWERK Reinraum- und Anlagentechnik is an engineering firm focused on providing controlled environment solutions. We assist clients through every phase of their project—from initial consultation and design to fabrication, installation, and formal validation.
          </p>
          <p style="margin-bottom: 20px; color:var(--slate-text);">
            Our modular approach ensures high quality, reduced construction timelines, and complete compliance with international cleanroom standards including DIN EN ISO 14644 and EU-GMP Annex 1.
          </p>
          <a href="/about" class="btn btn-primary">Learn More About Us</a>
        </div>
        <div class="card">
          <h3 style="font-size:1.15rem; margin-bottom:12px; color:var(--primary-navy);">Why Partner with REINWERK</h3>
          <ul class="card-list" style="margin-bottom:0;">
            <li><strong>Turnkey Execution:</strong> A single point of contact for architectural, mechanical, and validation scopes.</li>
            <li><strong>Compliance Assurance:</strong> Documentation aligned with ISO 14644, EU-GMP, and FDA expectations.</li>
            <li><strong>Modular Construction:</strong> Factory pre-finished components reduce on-site dust and assembly time.</li>
            <li><strong>Ongoing Support:</strong> Filter replacement, periodic re-certification, and emergency servicing.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Target Industries -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>Industries We Serve</h2>
        <p>Supplying specialized cleanroom solutions across key technical and regulated industries.</p>
      </div>

      <div class="grid-4">
        <div class="card">
          <h3 class="card-title">Pharmaceutical & Biotech</h3>
          <p class="card-desc">Sterile compounding, aseptic filling, and packaging suites compliant with GMP Grades A to D.</p>
        </div>
        <div class="card">
          <h3 class="card-title">Semiconductor & Electronics</h3>
          <p class="card-desc">Controlled environments for microelectronics, lithography, and nanotechnology manufacturing.</p>
        </div>
        <div class="card">
          <h3 class="card-title">Medical Devices</h3>
          <p class="card-desc">Controlled assembly cleanrooms adhering to ISO 13485 and bioburden control requirements.</p>
        </div>
        <div class="card">
          <h3 class="card-title">Aerospace & Optics</h3>
          <p class="card-desc">Clean areas for precision optics, laser alignment, and satellite instrumentation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Simple CTA -->
  <section class="cta-bar">
    <div class="container">
      <h2>Ready to Discuss Your Cleanroom Project?</h2>
      <p>Contact our engineering desk today for technical advice or request a fast project estimate.</p>
      <a href="/quote" class="btn btn-accent">Get a Quote</a>
      <a href="/contact" class="btn btn-outline" style="border-color:var(--white); color:var(--white); margin-left:10px;">Contact Us</a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
