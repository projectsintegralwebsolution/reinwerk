<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1><%= t('home.heroTitle') %></h1>
        <p>
          <%= t('home.heroDesc') %>
        </p>
        <div class="hero-buttons">
          <a href="/quote" class="btn btn-accent"><%= t('common.requestQuote') %></a>
          <a href="/services" class="btn btn-outline" style="border-color:var(--white); color:var(--white);"><%= t('common.ourServices') %></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2><%= t('home.coreServicesTitle') %></h2>
        <p><%= t('home.coreServicesSubtitle') %></p>
      </div>

      <div class="grid-4">
        <% services.slice(0, 4).forEach((srv) => { %>
          <div class="card">
            <div class="card-img">
              <img src="<%= srv.heroImage %>" alt="<%= srv.title %>">
            </div>
            <h3 class="card-title"><%= srv.title %></h3>
            <p class="card-desc"><%= srv.shortDescription %></p>
            <ul class="card-list">
              <% srv.keyFeatures.slice(0, 3).forEach((feat) => { %>
                <li><%= feat.title %></li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- About Company Intro -->
  <section class="section section-alt">
    <div class="container">
      <div class="grid-2" style="align-items: center;">
        <div>
          <h2><%= t('home.aboutTitle') %></h2>
          <p style="margin-bottom: 16px; color:var(--slate-text);">
            <%= t('home.aboutText1') %>
          </p>
          <p style="margin-bottom: 20px; color:var(--slate-text);">
            <%= t('home.aboutText2') %>
          </p>
          <a href="/about" class="btn btn-primary"><%= t('common.learnMore') %></a>
        </div>
        <div class="card">
          <h3 style="font-size:1.15rem; margin-bottom:12px; color:var(--primary-navy);"><%= t('home.whyTitle') %></h3>
          <ul class="card-list" style="margin-bottom:0;">
            <li><strong><%= t('home.why1Title') %>:</strong> <%= t('home.why1Desc') %></li>
            <li><strong><%= t('home.why2Title') %>:</strong> <%= t('home.why2Desc') %></li>
            <li><strong><%= t('home.why3Title') %>:</strong> <%= t('home.why3Desc') %></li>
            <li><strong><%= t('home.why4Title') %>:</strong> <%= t('home.why4Desc') %></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Target Industries -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2><%= t('home.industriesTitle') %></h2>
        <p><%= t('home.industriesSubtitle') %></p>
      </div>

      <div class="grid-4">
        <% industries.slice(0, 4).forEach((ind) => { %>
          <div class="card">
            <h3 class="card-title"><%= ind.title %></h3>
            <p class="card-desc"><%= ind.shortDescription %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Simple CTA -->
  <section class="cta-bar">
    <div class="container">
      <h2><%= t('home.ctaTitle') %></h2>
      <p><%= t('home.ctaDesc') %></p>
      <a href="/quote" class="btn btn-accent"><%= t('common.requestQuote') %></a>
      <a href="/contact" class="btn btn-outline" style="border-color:var(--white); color:var(--white); margin-left:10px;"><%= t('common.contactUs') %></a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
