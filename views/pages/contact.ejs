<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1>Contact Us</h1>
      <p style="margin-bottom:0;">Get in touch with our cleanroom engineering desk for project inquiries or technical support.</p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:40px; align-items:flex-start;">
        <!-- Contact Information -->
        <div>
          <h2>Headquarters & Engineering Office</h2>
          <p style="color:var(--slate-text); margin-bottom:24px;">
            Reach out to our team via phone, email, or by completing the contact form. We respond to all inquiries within one business day.
          </p>

          <div class="card" style="margin-bottom:20px;">
            <h3 class="card-title">Stuttgart Office</h3>
            <p style="color:var(--slate-text); margin-bottom:8px;">
              <strong>Address:</strong><br>
              REINWERK Reinraum- und Anlagentechnik GmbH<br>
              Industriestraße 42<br>
              70565 Stuttgart, Germany
            </p>
            <p style="color:var(--slate-text); margin-bottom:8px;">
              <strong>Phone:</strong> <a href="tel:+497118947200">+49 (0) 711 8947 200</a>
            </p>
            <p style="color:var(--slate-text); margin-bottom:8px;">
              <strong>Email:</strong> <a href="mailto:info@reinwerk-cleanroom.com">info@reinwerk-cleanroom.com</a>
            </p>
            <p style="color:var(--slate-text); margin-bottom:0;">
              <strong>Hours:</strong> Monday – Friday: 08:00 – 18:00 CET
            </p>
          </div>

          <div class="card">
            <h3 class="card-title">Emergency Technical Support</h3>
            <p style="color:var(--slate-text); font-size:0.9375rem; margin-bottom:0;">
              For contracted facilities requiring urgent filter replacement, HVAC troubleshooting, or re-validation support, our emergency engineering line operates 24/7.
            </p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="card" style="padding:32px;">
          <h2 style="font-size:1.5rem; color:var(--primary-navy); margin-bottom:6px;">Send a Message</h2>
          <p style="font-size:0.9375rem; color:var(--slate-text); margin-bottom:24px;">
            Fill in your details below and an engineer will get back to you promptly.
          </p>

          <form id="contactForm">
            <div class="form-group">
              <label class="form-label" for="name">Your Name *</label>
              <input type="text" id="name" name="name" class="form-input" placeholder="e.g. Dr. Thomas Keller" required>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="email">Email Address *</label>
                <input type="email" id="email" name="email" class="form-input" placeholder="name@company.com" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" class="form-input" placeholder="+49 ...">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="company">Company / Institution</label>
                <input type="text" id="company" name="company" class="form-input" placeholder="e.g. BioTech Solutions GmbH">
              </div>
              <div class="form-group">
                <label class="form-label" for="sector">Industry Sector</label>
                <select id="sector" name="sector" class="form-select">
                  <option value="Pharmaceutical / Biotech">Pharmaceutical & Biotech</option>
                  <option value="Semiconductor / Electronics">Semiconductor & Electronics</option>
                  <option value="Medical Devices">Medical Devices</option>
                  <option value="Aerospace / Optics">Aerospace & Optics</option>
                  <option value="Other">Other Application</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Message *</label>
              <textarea id="message" name="message" class="form-textarea" placeholder="Please describe your cleanroom requirements or question..." required></textarea>
            </div>

            <button type="submit" class="btn btn-accent" style="width:100%;">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
