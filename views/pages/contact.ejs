<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="hero" style="padding:48px 0;">
    <div class="container">
      <h1><%= t('contactPage.pageTitle') %></h1>
      <p style="margin-bottom:0;"><%= t('contactPage.pageSubtitle') %></p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:40px; align-items:flex-start;">
        <!-- Consultation & Inquiries Information -->
        <div>
          <h2><%= t('contactPage.consultTitle') %></h2>
          <p style="color:var(--slate-text); margin-bottom:24px;">
            <%= t('contactPage.consultDesc') %>
          </p>

          <div class="card" style="margin-bottom:20px;">
            <h3 class="card-title"><%= t('contactPage.processTitle') %></h3>
            <ul class="card-list" style="margin-bottom:0;">
              <li><strong><%= t('contactPage.proc1Title') %></strong> <%= t('contactPage.proc1Desc') %></li>
              <li><strong><%= t('contactPage.proc2Title') %></strong> <%= t('contactPage.proc2Desc') %></li>
              <li><strong><%= t('contactPage.proc3Title') %></strong> <%= t('contactPage.proc3Desc') %></li>
            </ul>
          </div>

          <div class="card">
            <h3 class="card-title"><%= t('contactPage.customQuoteTitle') %></h3>
            <p style="color:var(--slate-text); font-size:0.9375rem; margin-bottom:14px;">
              <%= t('contactPage.customQuoteDesc') %>
            </p>
            <a href="/quote" class="btn btn-primary" style="padding:8px 18px; font-size:0.875rem;"><%= t('common.openQuoteForm') %></a>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="card" style="padding:32px;">
          <h2 style="font-size:1.5rem; color:var(--primary-navy); margin-bottom:6px;"><%= t('contactPage.formTitle') %></h2>
          <p style="font-size:0.9375rem; color:var(--slate-text); margin-bottom:24px;">
            <%= t('contactPage.formSubtitle') %>
          </p>

          <form id="contactForm">
            <input type="hidden" name="lang" value="<%= lang %>">
            <div class="form-group">
              <label class="form-label" for="name"><%= t('contactPage.nameLabel') %></label>
              <input type="text" id="name" name="name" class="form-input" placeholder="<%= t('contactPage.namePlaceholder') %>" required>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="email"><%= t('contactPage.emailLabel') %></label>
                <input type="email" id="email" name="email" class="form-input" placeholder="<%= t('contactPage.emailPlaceholder') %>" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="phone"><%= t('contactPage.phoneLabel') %></label>
                <input type="tel" id="phone" name="phone" class="form-input" placeholder="<%= t('contactPage.phonePlaceholder') %>">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="company"><%= t('contactPage.companyLabel') %></label>
                <input type="text" id="company" name="company" class="form-input" placeholder="<%= t('contactPage.companyPlaceholder') %>">
              </div>
              <div class="form-group">
                <label class="form-label" for="sector"><%= t('contactPage.sectorLabel') %></label>
                <select id="sector" name="sector" class="form-select">
                  <option value="Pharmaceutical / Biotech"><%= t('contactPage.sectorPharma') %></option>
                  <option value="Semiconductor / Electronics"><%= t('contactPage.sectorSemi') %></option>
                  <option value="Medical Devices"><%= t('contactPage.sectorMedtech') %></option>
                  <option value="Aerospace / Optics"><%= t('contactPage.sectorAero') %></option>
                  <option value="Other"><%= t('contactPage.sectorOther') %></option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="message"><%= t('contactPage.messageLabel') %></label>
              <textarea id="message" name="message" class="form-textarea" placeholder="<%= t('contactPage.messagePlaceholder') %>" required></textarea>
            </div>

            <button type="submit" class="btn btn-accent" style="width:100%;"><%= t('contactPage.submitBtn') %></button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
