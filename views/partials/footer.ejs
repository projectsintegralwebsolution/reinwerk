<!-- Footer -->
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div style="background:#ffffff; display:inline-block; padding:8px 14px; border-radius:6px; margin-bottom:16px; box-shadow: 0 2px 8px rgba(0,0,0,0.18);">
          <img src="/images/logo.jpg" alt="REINWERK Logo" style="height:36px; width:auto; display:block;">
        </div>
        <p style="line-height:1.6; max-width:320px;">
          <%= t('footer.description') %>
        </p>
      </div>

      <div>
        <h4><%= t('footer.quickLinks') %></h4>
        <ul class="footer-links">
          <li><a href="/"><%= t('nav.home') %></a></li>
          <li><a href="/about"><%= t('nav.about') %></a></li>
          <li><a href="/services"><%= t('nav.services') %></a></li>
          <li><a href="/industries"><%= t('nav.industries') %></a></li>
          <li><a href="/projects"><%= t('nav.projects') %></a></li>
          <li><a href="/why-choose-us"><%= lang === 'en' ? 'Why Choose Us' : 'Warum REINWERK' %></a></li>
          <li><a href="/process"><%= lang === 'en' ? 'Process & Tech' : 'Entwicklungsprozess' %></a></li>
        </ul>
      </div>

      <div>
        <h4><%= t('footer.services') %></h4>
        <ul class="footer-links">
          <li><a href="/services/modular-cleanrooms"><%= lang === 'en' ? 'Modular Cleanrooms' : 'Modulare Reinraumsysteme' %></a></li>
          <li><a href="/services/cleanroom-hvac"><%= lang === 'en' ? 'HVAC & Filtration' : 'HLK- & Klimatechnik' %></a></li>
          <li><a href="/services/cleanroom-equipment"><%= lang === 'en' ? 'Equipment & Airlocks' : 'Schleusen & Reinstraumtechnik' %></a></li>
          <li><a href="/services/validation-testing"><%= lang === 'en' ? 'Validation & Testing' : 'Validierung & Messtechnik' %></a></li>
          <li><a href="/quote"><%= t('common.requestQuote') %></a></li>
        </ul>
      </div>

      <div>
        <h4><%= t('footer.getInTouch') %></h4>
        <p style="margin-bottom:10px; color:#cbd5e1; line-height:1.5;">
          <strong><%= lang === 'en' ? 'Address:' : 'Adresse:' %></strong><br>
          Pennsylvaniastraße 6<br>
          70569 Stuttgart, Germany
        </p>
        <p style="margin-bottom:14px; color:#cbd5e1; line-height:1.6;">
          <%= t('footer.inquiryText') %>
        </p>
        <a href="/contact" class="btn btn-accent" style="padding:7px 16px; font-size:0.875rem;"><%= t('footer.contactDesk') %></a>
      </div>
    </div>

    <div class="footer-bottom">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <p style="margin:0;">© <%= currentYear %> REINWERK Reinraum- und Anlagentechnik GmbH. <%= t('common.allRightsReserved') %> • reinwerk.co</p>
        <div class="lang-switch">
          <a href="<%= currentPath %>?lang=de" class="lang-btn <%= lang === 'de' ? 'active' : '' %>">Deutsch (DE)</a>
          <span class="lang-divider">|</span>
          <a href="<%= currentPath %>?lang=en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">English (EN)</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Toast Container -->
<div id="appToast" class="toast"></div>

<!-- Main Script -->
<script src="/js/main.js"></script>
